{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-pick-folder",
    "allow-list-dir-names",
    "allow-list-relative-file-paths",
    "allow-read-file-bytes",
    "allow-write-atomic",
    "allow-list-backups",
    "allow-restore-backup",
    "allow-delete-backup",
    "allow-app-version",
    "allow-open-external"
  ]
}
